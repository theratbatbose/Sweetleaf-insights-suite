{
  "name": "sweetleaf-suite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,app -c green,blue \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --target=node20 --outfile=build/server.mjs",
    "start": "node build/server.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "launch": "node scripts/launch.mjs"
  },
  "dependencies": {
    "docx": "^9.8.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "node-html-parser": "^9.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.3"
  },
  "description": "Local-first workspace for qualitative research: study setup, recordings, transcripts, analysis grid, synthesis and topline.",
  "engines": {
    "node": ">=20.10"
  }
}
